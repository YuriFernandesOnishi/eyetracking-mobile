{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["facelandmarker"],
  "ios": {
    "iosModuleName": "FaceLandmarker"
  },
  "android": {
    "androidNamespace": ["facelandmarker"],
    "androidCxxLibName": "FaceLandmarker"
  },
  "autolinking": {
    "FaceLandmarkerPlugin": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFaceLandmarkerPlugin"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
